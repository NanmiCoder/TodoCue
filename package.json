{
  "name": "todocue",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "TodoCue: local task runtime with a macOS notch/side-panel client, CLI and MCP.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.build.json --noEmit",
    "dev:serve": "tsx packages/cli/src/index.ts serve",
    "todocue": "node packages/cli/dist/index.js",
    "macos:build": "scripts/build-macos.sh",
    "macos:dmg": "node scripts/package-macos.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "install:local": "npm run build && node packages/cli/dist/index.js install",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run build && npm test && npm run test:release && npm run test:smoke && npm run release:check",
    "check:macos": "npm run check && swift test --package-path apps/macos"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
